# PostgreSQL（Vercel Postgres 或 Neon）
# 例：postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# 登入 session（請改成隨機長字串，至少 32 字元）
SESSION_SECRET="please-change-this-to-a-long-random-secret"

# LINE Messaging API
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# 對外 HTTPS 網址（Vercel 可留空，會自動用 VERCEL_URL）
# 本機開發：http://localhost:3000 或 ngrok 網址
APP_BASE_URL="http://localhost:3000"

# Vercel Blob（在 Vercel 後台建立 Blob Store 後自動注入）
# 本機開發可留空，照片會暫存 public/uploads
BLOB_READ_WRITE_TOKEN=""
